[Unit]
Description=InterviewFlashcards consistent server backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=kevin
UMask=0077
WorkingDirectory=/srv/interview-flashcards
ExecStart=/usr/bin/python3 /srv/interview-flashcards/tools/automatic-backup.py backup --config /srv/interview-flashcards/deploy/backup-policy.json
# Allow graceful service restart in the snapshot EXIT trap on a normal stop.
KillMode=control-group
TimeoutStartSec=infinity
TimeoutStopSec=300
