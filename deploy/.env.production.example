# Copy to deploy/.env.production (ignored); never commit real credentials or keys.
POSTGRES_DB=interview_flashcards
POSTGRES_USER=flashcards
POSTGRES_PASSWORD=
ACCOUNT_USERNAME=
# Preserve literal $ characters with single quotes.
ACCOUNT_PASSWORD_HASH=''
BACKEND_IMAGE=interview-flashcards-backend:REPLACE_WITH_RELEASE_ID
WEB_IMAGE=interview-flashcards-web:REPLACE_WITH_RELEASE_ID
PUBLIC_HOST=study.example.com
# Absolute host directory; contains fullchain.pem and privkey.pem, mounted read-only.
TLS_CERT_DIR=/srv/interview-flashcards/tls
WEB_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
MAVEN_MIRROR_URL=https://repo1.maven.org/maven2

# P1-08: disabled by default; ACCOUNT_* only initializes/binds the preset identity once.
REGISTRATION_ENABLED=false
USER_STORAGE_MAX_BYTES=536870912
USER_SOURCE_LIMIT=20
USER_IMPORT_LIMIT=2
USER_BACKUP_LIMIT=2
GLOBAL_TASK_LIMIT=20
GLOBAL_STORAGE_MAX_BYTES=5368709120
STORAGE_RESERVE_BYTES=536870912
