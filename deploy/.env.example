# Copy to .env (ignored). Fill these locally; never commit the resulting .env.
POSTGRES_DB=interview_flashcards
POSTGRES_USER=flashcards
POSTGRES_PASSWORD=
ACCOUNT_USERNAME=
# BCrypt cost 10..16; use single quotes in .env so Compose preserves literal dollar signs.
ACCOUNT_PASSWORD_HASH=''
DB_PORT=55432
WEB_PORT=8088
WEB_BIND_ADDRESS=127.0.0.1
# Local HTTP only. For HTTPS use compose.production.yml and .env.production.example.
SESSION_COOKIE_SECURE=false
# Optional container build repository (official Maven Central endpoint).
MAVEN_MIRROR_URL=https://repo1.maven.org/maven2
