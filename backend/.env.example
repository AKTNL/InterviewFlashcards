# Export these in your shell; Spring does not automatically read this file.
DATABASE_URL=jdbc:postgresql://127.0.0.1:55432/interview_flashcards
DATABASE_USERNAME=flashcards
DATABASE_PASSWORD=
ACCOUNT_USERNAME=
ACCOUNT_PASSWORD_HASH=
SERVER_PORT=8080
STORAGE_ROOT=./data/files
STORAGE_TEMP_ROOT=./data/tmp
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=30m

# P1-08: disabled by default; ACCOUNT_* only initializes/binds the preset identity once.
REGISTRATION_ENABLED=false
# Maximum successful registrations (maintenance and personal invitations combined).
REGISTRATION_MAX_ACCOUNTS=100
USER_STORAGE_MAX_BYTES=536870912
USER_SOURCE_LIMIT=20
USER_IMPORT_LIMIT=2
USER_BACKUP_LIMIT=2
GLOBAL_TASK_LIMIT=20
GLOBAL_STORAGE_MAX_BYTES=5368709120
STORAGE_RESERVE_BYTES=536870912
